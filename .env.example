# URL do llama-server usada somente pelo proxy de desenvolvimento do Vite.
# Use a porta informada no log do servidor local.
YOSHI_SERVER_URL=http://127.0.0.1:1234
VITE_YOSHI_MODEL=Yoshi
# Se o llama-server tiver sido iniciado com --api-key, informe a mesma chave aqui.
# Caso não exija autenticação, deixe esta variável ausente.
VITE_YOSHI_API_KEY=
# Em produção, use um backend/proxy HTTPS. Não aponte o navegador diretamente
# para o llama-server local.
# VITE_YOSHI_API_URL=https://seu-dominio.com/api/yoshi
